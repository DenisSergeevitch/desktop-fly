{
  "name": "desktopfly-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows port of DesktopFly - real FlyWire connectome, live LIF sim",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "datatest": "node src/cli/datatest.ts",
    "simtest": "node src/cli/simtest.ts",
    "simtest:strict": "node src/cli/simtest.ts --strict",
    "typecheck": "tsc --noEmit",
    "behaviortest": "node src/cli/behaviortest.ts",
    "build": "node build.mjs",
    "start": "npm run build && electron dist/main.cjs",
    "snapshot": "npm run build && electron dist/snapshot.cjs",
    "sensetest": "node src/cli/sensetest.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "dependencies": {
    "electron": "^43.4.1",
    "koffi": "^3.1.5",
    "three": "^0.185.1"
  }
}
